# SAMANTHA App Environment Configuration
# Copy to .env and adjust values for your environment

# PRISM sync API base. The app appends /api/v1/sync.
VITE_API_BASE=http://localhost:3333

# Voice Token Server — provides LiveKit tokens for voice calls.
VITE_VOICE_TOKEN_ENDPOINT=http://localhost:3010/api/voice/token
VITE_LIVEKIT_URL=ws://localhost:7880
